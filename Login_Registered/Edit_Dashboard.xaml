<!--EDIT PRODUCTS / ADD TRACKING ID PAGE-->
<Window x:Class="Login_Registered.Edit_Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Login_Registered"
        mc:Ignorable="d"
       Title="Edit Dashboard" 
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        WindowStyle="ThreeDBorderWindow" Background="#04c582" Icon="C:\Users\abhi\Desktop\hcci_logo.jpg" Height="700" Width="1200">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">

        <Grid Height="630" Background="Black" Width="1200">

            <!--Refresh Button-->
            <Button Foreground="White" Width="77" Background="Brown" Click="Refresh_Click" Cursor="Hand" FontSize="15" Content="Refresh" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" />

            <!--Back to Purchased Checkout Entries-->
            <Button Foreground="White" Width="207" Background="Green" Click="BackToPurchasedCheckout_Click" Cursor="Hand" FontSize="15" Content="Purchased Checkout Entries" HorizontalAlignment="Left" Margin="99,10,0,0" VerticalAlignment="Top" />

            <!--Back to Abandoned Checkout Entries-->
            <Button Foreground="White" Width="207" Background="Red" Click="BackToAbandonedCheckout_Click" Cursor="Hand" FontSize="15" Content="Abandoned Checkout Entries" HorizontalAlignment="Left" Margin="320,10,0,0" VerticalAlignment="Top" />

            <!--Back to Dashboard button-->
            <Button Foreground="DarkGreen" Width="138" Background="Yellow" Click="BackToDashboard_Click" Cursor="Hand" FontSize="15" Content="Dashboard" HorizontalAlignment="Left" Margin="548,10,0,0" VerticalAlignment="Top" />

            <!--Logout Button-->
            <Button HorizontalAlignment="Right" FontSize="18" Foreground="White" Width="72" Background="#04c582" Content="Logout" Margin="0,42,25,0" VerticalAlignment="Top" Click="Logout_Click"/>

            <!--Connected/Not connected status-->
            <Label HorizontalAlignment="Right" Content="Conneted / Not-Connected" Name="status" FontSize="12" Foreground="White" Margin="0,75,25,532"  />

            <!--Main Heading (Purchased Checkout)-->
            <Label Foreground="White" FontSize="25" Content="Edit Your Dashboard" HorizontalContentAlignment="Center" Margin="354,27,334,0" VerticalAlignment="Top" Width="395"/>

            <!--Profile Image-->
            <Image  Name="ProfileSession" HorizontalAlignment="Left" Height="100" Margin="922,10,0,0" VerticalAlignment="Top" Width="100"/>

            <!---UsernameSession-->
            <Label Name="UsernameSession" FontSize="18" Foreground="White" Content="Username_Session" HorizontalContentAlignment="Right" HorizontalAlignment="Right" Margin="0,10,25,0" VerticalAlignment="Top" Width="151"/>


            <Label Foreground="Red" FontSize="18" Content="Edit the Product Prices" HorizontalAlignment="Left" Margin="34,90,0,0" VerticalAlignment="Top" Width="236"/>
            <!--Choose Product-->
            <Label FontSize="18" Foreground="White" Content="Choose Product" HorizontalAlignment="Left" Margin="34,124,0,0" VerticalAlignment="Top" Width="219"/>
            <RadioButton Name="BS100" GroupName="BS" Checked = "BSCheck" FontSize="18" Foreground="White" Content="Blanket Sauna - BS 100, Far Infrared Sauna Blanket" HorizontalAlignment="Left" Margin="34,167,0,0" VerticalAlignment="Top" Height="28" Width="425"/>
            <RadioButton Name="BS103" GroupName="BS" Checked = "BSCheck" FontSize="18" Foreground="White" Content="Blanket Sauna - BS 103, Jade and Tourmaline Stones" HorizontalAlignment="Left" Margin="34,200,0,0" VerticalAlignment="Top" Height="28" Width="550"/>
            <RadioButton Name="BS106" GroupName="BS" Checked = "BSCheck" FontSize="18" Foreground="White" Content="Blanket Sauna - BS 106, Bain Stones, Negative Ionic Cloth and Photon Lights" HorizontalAlignment="Left" Margin="34,233,0,0" VerticalAlignment="Top" Height="28" Width="577"/>

            <Separator Background="Yellow" HorizontalAlignment="Left" Height="20" Margin="34,282,0,0" VerticalAlignment="Top" Width="534"/>

            <!--Product Variant you have-->
            <Label FontSize="18" Foreground="White" Content="Product Variant You Have" HorizontalAlignment="Left" Margin="34,348,0,0" VerticalAlignment="Top" Width="219"/>
            <TextBox Name="ProductVariant" Background="#545d6a" Foreground="White" FontSize="18" HorizontalAlignment="Left" Height="23" Margin="367,359,0,0" VerticalAlignment="Top" Width="201"/>


            <!--Original Amount (MRP)-->
            <Label FontSize="18" Foreground="White" Content="Original Amount of Chosen Product" HorizontalAlignment="Left" Margin="34,402,0,0" VerticalAlignment="Top" Width="299"/>
            <TextBox Name="OriginalAmount" Background="#545d6a" Foreground="White" FontSize="18" HorizontalAlignment="Left" Height="23" Margin="367,413,0,0" VerticalAlignment="Top" Width="201"/>

            <!--Purchased Amount-->
            <Label FontSize="18" Foreground="White" Content="Purchased Customer Amount" HorizontalAlignment="Left" Margin="34,459,0,0" VerticalAlignment="Top" Width="299"/>
            <TextBox Name="PurchasedAmount" Background="#545d6a" Foreground="White" FontSize="18" HorizontalAlignment="Left" Height="23" Margin="367,470,0,0" VerticalAlignment="Top" Width="201"/>


            <!--Submit Changes-->
            <Button HorizontalAlignment="Left" Click="SubmitChanges_Click"  Cursor="Hand" Height="36" Foreground="White" Background="#04c582" FontSize="18" Content="Submit Changes" Margin="34,536,0,0" VerticalAlignment="Top" Width="142"/>


            <!---**********************************************-->


            <Separator Background="Yellow" Height="20" Margin="349,334,323,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                <Separator.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="90"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Separator.RenderTransform>
            </Separator>


            <!---**********************************************-->

            <Label Foreground="Red" FontSize="18" Content="Add Tracking ID" HorizontalAlignment="Left" Margin="628,90,0,0" VerticalAlignment="Top" Width="236"/>
            <!--Order Number Searched-->
            <Label FontSize="18" Foreground="White" Content="Order Number Search" HorizontalAlignment="Left" Margin="628,160,0,0" VerticalAlignment="Top" Width="195"/>
            <TextBox Name="OrderNumber" Background="#545d6a" Foreground="White" FontSize="18" HorizontalAlignment="Left" Height="23" Margin="847,160,0,0" VerticalAlignment="Top" Width="201" KeyDown="OrderNumber_KeyDown" TextChanged="OrderNumber_TextChanged"/>

            <!---Display searched Order Id details in Datagrid-->
            <DataGrid Name="DisplaySearch" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Visible" FontSize="12" HorizontalAlignment="Right" Height="76" VerticalAlignment="Top" Width="547" Margin="0,204,25,0"/>


            <!--Tracking Service Name-->
            <Label FontSize="18" Foreground="White" Content="Tracking Service Name" HorizontalAlignment="Left" Margin="628,291,0,0" VerticalAlignment="Top" Width="195"/>
            <TextBox Name="TrackingServiceName" Background="#545d6a" Foreground="White" FontSize="18" HorizontalAlignment="Left" Height="23" Margin="847,302,0,0" VerticalAlignment="Top" Width="200"/>

            <!--Tracking ID-->
            <Label FontSize="18" Foreground="White" Content="Tracking ID" HorizontalAlignment="Left" Margin="628,348,0,0" VerticalAlignment="Top" Width="195"/>
            <TextBox Name="TrackingID" Background="#545d6a" Foreground="White" FontSize="18" HorizontalAlignment="Left" Height="23" Margin="847,359,0,0" VerticalAlignment="Top" Width="200"/>


            <!--Add Shipped Status (Yes/No)-->
            <Label Foreground="Red" FontSize="18" Content="Shipped Or Not?" HorizontalAlignment="Left" Margin="628,479,0,0" VerticalAlignment="Top" Width="166"/>
            <RadioButton Name="Yes" GroupName="Shipped" Checked = "ShippedCheck" FontSize="18" Foreground="White" Content="Yes" HorizontalAlignment="Left" Margin="847,488,0,0" VerticalAlignment="Top" Height="28" Width="79"/>
            <RadioButton Name="No" GroupName="Shipped" Checked = "ShippedCheck" FontSize="18" Foreground="White" Content="No" HorizontalAlignment="Left" Margin="847,521,0,0" VerticalAlignment="Top" Height="28" Width="79"/>
                        
            <!--Submit Button for Shipped Status-->
            <Button HorizontalAlignment="Left" Click="SubmitShippedStatus_Click"  Cursor="Hand" Height="36" Foreground="White" Background="#04c582" FontSize="18" Content="Confirm Shipped Status" Margin="628,547,0,0" VerticalAlignment="Top" Width="195"/>
            
            <!--Submit button for Tracking ID-->
            <Button HorizontalAlignment="Left" Click="SubmitTracking_Click"  Cursor="Hand" Height="36" Foreground="White" Background="#04c582" FontSize="18" Content="Submit Tracking ID" Margin="628,411,0,0" VerticalAlignment="Top" Width="166"/>
            <Separator Background="Yellow" HorizontalAlignment="Left" Height="20" Margin="628,452,0,0" VerticalAlignment="Top" Width="534"/>

        </Grid>
    </ScrollViewer>

</Window>
