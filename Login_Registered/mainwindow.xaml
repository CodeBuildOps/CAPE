<!--LOGIN PAGE-->
<Window x:Class="Login_Registered.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Login_Registered"
        mc:Ignorable="d"
        Title="LogIn" Left="500" Top="220" ResizeMode="NoResize" Height="412.672" Width="330" FontSize="14" Background="#04c582" Icon="C:\Users\abhi\Desktop\hcci_logo.jpg">
    <Border Background="black" CornerRadius="20" Margin="20">
        <StackPanel Margin="20,20,20,0">

            <!--Refresh Button-->
            <Button Foreground="White" HorizontalAlignment="Left" Width="50"  Background="#04c582" Click="Refresh_Click" Cursor="Hand" FontSize="10" Content="Refresh" HorizontalContentAlignment="center"/>

            <!--Connected/Not connected status-->
            <Label Name="status" FontSize="10" Foreground="White" HorizontalContentAlignment="Right"/>
            
            <!--Main Heading-->
            <Label Foreground="White" Content="Login" FontSize="25" HorizontalAlignment="Center" Margin="70,0"/>
            <Separator></Separator>

            <!--Username-->
            <Label Foreground="White" Content="Username"/>
            <TextBox Name="username" Background="#545d6a" Foreground="White" FontSize="18" />

            <!--Password-->
            <Label Foreground="White" Content="Password"/>
            <PasswordBox Name="password" Background="#545d6a" Foreground="White" FontSize="18" KeyDown="Password_KeyDown"/>

            <!--Login Button-->
            <Button FontSize="18" Name="login" Foreground="White" Margin="50 10"  Background="#04c582" Content="Login" Click="Login_Click" Cursor="Hand"/>

            <!--Not Register-->
            <Button FontSize="12" Name="registration_link" Foreground="White" Margin="60 8"  Background="{x:Null}" Content="Not Register?" HorizontalContentAlignment="Center" Cursor="Hand" Click="Registration_link_Click" BorderThickness="0"/>
            
            <!--Forget Password-->

            <Button  FontSize="10" x:Name="ForgetPassword_link" Foreground="White" Margin="60 8"  Background="{x:Null}" Content="Forget Password?" HorizontalContentAlignment="Center" Cursor="Hand" Click="ForgetPassword_link_Click" BorderThickness="0"/>




        </StackPanel>
    </Border>
</Window>


