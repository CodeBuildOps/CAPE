<Window x:Class="Login_Registered.Display_Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Login_Registered"
        mc:Ignorable="d"
        Title="Dashboard" 
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        WindowStyle="ThreeDBorderWindow" Background="#04c582" Icon="C:\Users\abhi\Desktop\hcci_logo.jpg" Height="1320" Width="1356">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">

        <Grid Height="1137" Background="Black" Width="1322">

            <!--Refresh Button-->
            <Button Foreground="White" Width="77" Background="Brown" Click="Refresh_Click" Cursor="Hand" FontSize="15" Content="Refresh" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" />

            <!--Back to Purchased Checkout Entries-->
            <Button Foreground="White" Width="207" Background="Green" Click="BackToPurchasedCheckout_Click" Cursor="Hand" FontSize="15" Content="Purchased Checkout Entries" HorizontalAlignment="Left" Margin="99,10,0,0" VerticalAlignment="Top" />

            <!--Back to Abandoned Checkout Entries-->
            <Button Foreground="White" Width="207" Background="Red" Click="BackToAbandonedCheckout_Click" Cursor="Hand" FontSize="15" Content="Abandoned Checkout Entries" HorizontalAlignment="Left" Margin="320,10,0,0" VerticalAlignment="Top" />

            <!--Back to Edit Dashboard button-->
            <Button Foreground="DarkGreen" Width="174" Background="Yellow" Click="BackToEditDashboard_Click" Cursor="Hand" FontSize="15" Content="Edit Product / Tracking " HorizontalAlignment="Left" Margin="548,10,0,0" VerticalAlignment="Top" />

            <!--Logout Button-->
            <Button HorizontalAlignment="Right" FontSize="18" Foreground="White" Width="72" Background="#04c582" Content="Logout" Margin="0,42,25,0" VerticalAlignment="Top" Click="Logout_Click"/>

            <!--Connected/Not connected status-->
            <Label HorizontalAlignment="Right" Content="Conneted / Not-Connected" Name="status" FontSize="12" Foreground="White" Margin="0,75,25,532"  />

            <!--Main Heading (Purchased Checkout)-->
            <Label Foreground="White" FontSize="25" Content="Display Dashboard" HorizontalContentAlignment="Center" Margin="354,27,334,0" VerticalAlignment="Top" Width="395"/>

            <!--Profile Image-->
            <Image  Name="ProfileSession" HorizontalAlignment="Left" Height="100" Margin="922,10,0,0" VerticalAlignment="Top" Width="100"/>


            <!---UsernameSession-->
            <Label Name="UsernameSession" FontSize="18" Foreground="White" Content="Username_Session" HorizontalContentAlignment="Right" HorizontalAlignment="Right" Margin="0,10,25,0" VerticalAlignment="Top" Width="151"/>

            <!-- *****************************-->


            <!--Your Products-->
            <Label FontSize="18" Foreground="White" Content="Your Products" HorizontalAlignment="Left" Margin="10,76,0,0" VerticalAlignment="Top" Width="219"/>
            <!--BS 100-->
            <Image HorizontalAlignment="Left" Height="100" Margin="10,119,0,0" VerticalAlignment="Top" Width="162"/>
            <Label FontSize="18" Foreground="White" Content="BS 100" HorizontalAlignment="Left" Margin="10,219,0,0" VerticalAlignment="Top" Width="205"/>
            <Label FontSize="18" Foreground="White" Content="Original Price : $USD" HorizontalAlignment="Left" Margin="10,253,0,0" VerticalAlignment="Top" Width="205"/>
            <Label FontSize="18" Foreground="White" Content="Customer Price : $USD" HorizontalAlignment="Left" Margin="10,284,0,0" VerticalAlignment="Top" Width="205"/>


            <!--BS 103-->
            <Image HorizontalAlignment="Left" Height="100" Margin="233,119,0,0" VerticalAlignment="Top" Width="164" RenderTransformOrigin="0.897,0.494"/>
            <Label FontSize="18" Foreground="White" Content="BS 103" HorizontalAlignment="Left" Margin="233,219,0,0" VerticalAlignment="Top" Width="100"/>
            <Label FontSize="18" Foreground="White" Content="Original Price : $USD" HorizontalAlignment="Left" Margin="233,253,0,0" VerticalAlignment="Top" Width="205"/>
            <Label FontSize="18" Foreground="White" Content="Customer Price : $USD" HorizontalAlignment="Left" Margin="233,284,0,0" VerticalAlignment="Top" Width="205"/>


            <!--BS 106-->
            <Image HorizontalAlignment="Left" Height="100" Margin="427,114,0,0" VerticalAlignment="Top" Width="165"/>
            <Label FontSize="18" Foreground="White" Content="BS 106" HorizontalAlignment="Left" Margin="427,219,0,0" VerticalAlignment="Top" Width="100"/>
            <Label FontSize="18" Foreground="White" Content="Original Price : $USD" HorizontalAlignment="Left" Margin="427,253,0,0" VerticalAlignment="Top" Width="205"/>
            <Label FontSize="18" Foreground="White" Content="Customer Price : $USD" HorizontalAlignment="Left" Margin="427,284,0,0" VerticalAlignment="Top" Width="205"/>


            <Separator Background="Yellow" HorizontalAlignment="Left" Height="28" Margin="14,329,0,0" VerticalAlignment="Top" Width="605"/>

            <!--Dispaly All members-->
            <Label FontSize="18" Foreground="White" Content="All Member We Have" HorizontalAlignment="Left" Margin="14,387,0,0" VerticalAlignment="Top" Width="219"/>
            <DataGrid  Background="Beige" Name="all_members" FontSize="12" Height="250" Margin="14,426,688,461"/>


            <!--Members Add/Delete/Update-->
            <Button HorizontalAlignment="Left" Click="AddMember_Click"  Cursor="Hand" Height="36" Foreground="White" Background="#04c582" FontSize="18" Content="Add Member" Margin="14,706,0,0" VerticalAlignment="Top" Width="142"/>
            <Button HorizontalAlignment="Left" Click="UpdateMember_Click"  Cursor="Hand" Height="36" Foreground="White" Background="#04c582" FontSize="18" Content="Update Member" Margin="191,706,0,0" VerticalAlignment="Top" Width="142"/>
            <Button HorizontalAlignment="Left" Click="DeleteMember_Click"  Cursor="Hand" Height="36" Foreground="White" Background="#04c582" FontSize="18" Content="Delete Member" Margin="358,706,0,0" VerticalAlignment="Top" Width="142"/>


            <Separator Background="Yellow" HorizontalAlignment="Left" Height="28" Margin="10,767,0,0" VerticalAlignment="Top" Width="605"/>


            <!--Display Relevant Purchased Checkout info-->
            <Label FontSize="18" Foreground="White" Content="All Purchased Checkout" HorizontalAlignment="Left" Margin="700,838,0,0" VerticalAlignment="Top" Width="219"/>
            <DataGrid  Background="Beige" Name="PurchasedCheckout" FontSize="12" Height="250" Margin="692,887,10,0"/>

            <!--Display Relevant Abandoned Checkout info-->
            <Label FontSize="18" Foreground="White" Content="All Abandoned Checkout" HorizontalAlignment="Left" Margin="14,838,0,0" VerticalAlignment="Top" Width="219"/>
            <DataGrid Background="Beige"  Name="AbandonedCheckout" FontSize="12" Height="250" Margin="10,877,692,10"/>


            <!---**********************************************-->


            <Separator Background="Yellow" Height="20" Margin="210,591,196,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                <Separator.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="90"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Separator.RenderTransform>
            </Separator>


            <!---**********************************************-->


            <!--Order Number Searched-->
            <Label FontSize="18" Foreground="White" Content="Order Number Search" HorizontalAlignment="Left" Margin="700,160,0,0" VerticalAlignment="Top" Width="219"/>
            <TextBox Name="OrderNumber" Background="#545d6a" Foreground="White" FontSize="18" HorizontalAlignment="Left" Height="23" Margin="974,160,0,0" VerticalAlignment="Top" Width="201"/>

            <!--Display the searched Order Id details-->
            <TextBlock FontSize="15" Foreground="Red" Background="Beige" HorizontalAlignment="Left" Margin="700,219,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Height="125" Width="605"/>

            <!--Total 
            1. Sales
            2. Abandoned
            3. Country List
            -->
            <TextBlock Background="DarkMagenta" HorizontalAlignment="Left" Margin="700,368,0,0" TextWrapping="Wrap" Text="Total Sales Related BS 100" VerticalAlignment="Top" Height="132" Width="178"/>
            <TextBlock Background="Chartreuse" HorizontalAlignment="Left" Margin="922,368,0,0" TextWrapping="Wrap" Text="Total Sales Related BS 103" VerticalAlignment="Top" Height="132" Width="178"/>
            <TextBlock Background="Bisque" HorizontalAlignment="Left" Margin="1127,368,0,0" TextWrapping="Wrap" Text="Total Sales Related BS 106" VerticalAlignment="Top" Height="132" Width="178"/>

            <Separator Background="Yellow" HorizontalAlignment="Left" Height="28" Margin="700,537,0,0" VerticalAlignment="Top" Width="605"/>

        </Grid>
    </ScrollViewer>

</Window>
